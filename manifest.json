{
  "manifest_version": 3,
  "name": "Enhanced 23mofang",
  "version": "1.5.16",
  "description": "全国区县/市级地图，TheYtree、YFull、FTDNA公开古DNA、科研与匿名现代样本查询。",
  "permissions": ["storage"],
  "action": {"default_title":"Enhanced 23mofang · 功能开关","default_popup":"popup.html"},
  "host_permissions": ["https://www.theytree.com/*","https://www.yfull.com/*","https://discover.familytreedna.com/*"],
  "background": {"service_worker":"ancient/background.js"},
  "minimum_chrome_version": "111",
  "icons": {"48":"icons/48.png","128":"icons/128.png"},
  "content_scripts": [
    {"matches":["https://www.23mofang.com/*"],"js":["bridge.js","ancient/mofang-bridge.js","research/mofang-bridge.js","samples/ancestry-bridge.js","ancient/mofang-snp-bridge.js"],"run_at":"document_start","world":"MAIN"},
    {"matches":["https://www.23mofang.com/*"],"js":["content.js","ancient/ui.js","research/ui.js","samples/ui.js","ancient/mofang-snp-entry.js"],"run_at":"document_start"},
    {"matches":["https://www.theytree.com/tree/*"],"js":["ancient/source-bridge.js","research/source-bridge.js"],"run_at":"document_start","world":"MAIN"},
    {"matches":["https://www.theytree.com/tree/*"],"js":["ancient/source.js","research/source.js"],"run_at":"document_idle"}
  ],
  "web_accessible_resources": [{"resources":["assets/counties.geo.json","assets/cities.geo.json"],"matches":["https://www.23mofang.com/*"]}]
}
